# Copia este archivo a .env (git lo ignora) y cambia los valores. Solo para desarrollo.
# Los tres servicios lo leen desde su carpeta o desde la raíz del repositorio.

# Secreto HMAC del JWT (texto plano, mínimo 32 caracteres). El MISMO para los tres servicios:
# auth-service firma con él y customer-service y account-service validan con él.
JWT_SECRET=cambia-este-secreto-por-uno-de-al-menos-32-caracteres

# MySQL de docker-compose.yml: los servicios se conectan como root.
DB_USERNAME=root
DB_PASSWORD=cambia-esta-contrasena
# Puerto publicado en el host (por defecto 3307)
DB_PORT=3307
