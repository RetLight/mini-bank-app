{
  "info": {
    "name": "MiniBank API",
    "description": "Flujo de MiniBank por el API Gateway (http://localhost:8080). Ejecutar en orden: registro, logins (guardan los tokens), 401 sin token, CRUD de favoritos del dueño, 403 y 200 en /admin, transferencias y movimientos. Requiere el sistema levantado con el perfil dev.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Registro (crea cliente y usuario)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Devuelve token del usuario nuevo\", () => pm.expect(pm.response.json().token).to.be.a(\"string\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:8080/auth/register",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "auth",
            "register"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"eva{{$randomInt}}\",\n  \"password\": \"Secret123\",\n  \"documentType\": \"DNI\",\n  \"documentNumber\": \"2000{{$randomInt}}0\",\n  \"firstNames\": \"Eva\",\n  \"lastNames\": \"Rojas\",\n  \"email\": \"eva{{$randomInt}}@mail.com\",\n  \"phone\": \"999000111\"\n}"
        }
      }
    },
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"Devuelve token Bearer de 30 minutos\", () => {",
              "    pm.expect(body.token).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(body.tokenType).to.eql(\"Bearer\");",
              "    pm.expect(body.expiresIn).to.eql(1800);",
              "});",
              "pm.collectionVariables.set(\"token\", body.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:8080/auth/login",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"demo\",\n  \"password\": \"demo123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "Login admin",
      "event": [
        {
          "listen": "test",
          "script": {
