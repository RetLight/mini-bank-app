    {
      "name": "Admin: listar clientes",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Devuelve los clientes\", () => pm.expect(pm.response.json().length).to.be.above(3));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/admin/customers",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "admin",
            "customers"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Hacer transferencia",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test(\"Se crea con Factory: INTERNAL y COMPLETED\", () => {",
              "    pm.expect(body.type).to.eql(\"INTERNAL\");",
              "    pm.expect(body.status).to.eql(\"COMPLETED\");",
              "    pm.expect(body.currency).to.eql(\"PEN\");",
              "    pm.expect(body.sourceAccountId).to.eql(1);",
              "    pm.expect(body.destinationAccountId).to.eql(3);",
              "    pm.expect(body.requestedAt).to.eql(body.processedAt);",
              "});",
              "pm.collectionVariables.set(\"transferId\", body.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:8080/transfers",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "transfers"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sourceAccountId\": 1,\n  \"amount\": 10.0,\n  \"destinationCci\": \"00219100000000000003\",\n  \"destinationBank\": \"BCP\",\n  \"destinationHolder\": \"Luis Ramirez\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Ver transferencias",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Incluye la transferencia creada\", () => {",
              "    const ids = pm.response.json().map(t => t.id);",
              "    pm.expect(ids).to.include(Number(pm.collectionVariables.get(\"transferId\")));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/transfers?accountId=1",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "transfers"
          ],
          "query": [
            {
              "key": "accountId",
              "value": "1"
            }
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Ver movimientos",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"Todos son de la cuenta 1 y con tipo válido\", () => {",
              "    pm.expect(body).to.be.an(\"array\").and.not.empty;",
              "    body.forEach(m => {",
              "        pm.expect(m.accountId).to.eql(1);",
              "        pm.expect([\"INCREASE\", \"DECREASE\"]).to.include(m.type);",
              "    });",
              "});",
              "pm.test(\"La transferencia creada generó un DECREASE\", () => {",
              "    const id = Number(pm.collectionVariables.get(\"transferId\"));",
              "    const m = body.find(x => x.transferId === id);",
              "    pm.expect(m).to.exist;",
              "    pm.expect(m.type).to.eql(\"DECREASE\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/movements?accountId=1",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "movements"
          ],
          "query": [
            {
              "key": "accountId",
              "value": "1"
            }
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
